{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HashiMemo",
  "version": "0.3.1",
  "identifier": "com.weslinsx.hashimemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HashiMemo",
        "width": 360,
        "height": 760,
        "minWidth": 64,
        "minHeight": 64,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "backgroundColor": "#181825",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false
      },
      {
        "label": "bubble",
        "url": "index.html?bubble=1",
        "title": "HashiMemo",
        "width": 84,
        "height": 84,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/HashiMemo/media/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Notas rápidas em Markdown na borda da tela",
    "longDescription": "HashiMemo mantém notas em arquivos Markdown com frontmatter YAML na borda da tela, sincronizadas com agentes de IA locais via CLI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
